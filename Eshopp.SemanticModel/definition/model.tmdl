model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

annotation PBI_QueryOrder = ["customers","website_sessions","sales","dates","products","stores","geographies"]

ref table customers
ref table website_sessions
ref table sales
ref table dates
ref table products
ref table stores
ref table geographies

ref cultureInfo en-US

